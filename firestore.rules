rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Sadece giriş yapmış kullanıcılar okuyabilir/yazabilir.
    // İleride kullanıcı bazlı yetkilendirme eklemek isterseniz
    // (örn. sadece belirli e-postalar), bu kuralı genişletebiliriz.
    match /distributors/{docId} {
      allow read, write: if request.auth != null;
    }

    match /fuarlar/{docId} {
      allow read, write: if request.auth != null;
    }

    match /todos/{docId} {
      allow read, write: if request.auth != null;

      match /notlar/{notId} {
        allow read, write: if request.auth != null;
      }
    }

    match /haber_sorgulari/{docId} {
      allow read, write: if request.auth != null;
    }

    match /takip_edilen_ulkeler/{docId} {
      allow read, write: if request.auth != null;
    }

    match /ayarlar/{docId} {
      allow read, write: if request.auth != null;
    }

    match /manuel_ciro/{docId} {
      allow read, write: if request.auth != null;
    }

    match /kartvizitler/{docId} {
      allow read, write: if request.auth != null;
    }

    match /mesaj_sablonlari/{docId} {
      allow read, write: if request.auth != null;
    }

    // Değişiklik günlüğü — herkes (giriş yapmış kullanıcı) yazabilir, ama
    // sadece yönetim hesabı okuyabilir. Bu, frontend'deki görünürlük
    // kontrolünü sunucu tarafında da zorunlu kılar.
    match /degisiklik_loglari/{docId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.token.email == "yonetim@pimetri.com";
    }

    // Başka bir koleksiyona (örn. ihaleler) izin verilmedi —
    // ileride modül eklerken buraya yeni match blokları eklenecek.
  }
}
