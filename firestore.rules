rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Sadece giriş yapmış kullanıcılar okuyabilir/yazabilir.
    // İleride kullanıcı bazlı yetkilendirme eklemek isterseniz
    // (örn. sadece belirli e-postalar), bu kuralı genişletebiliriz.
    match /distributors/{docId} {
      allow read, write: if request.auth != null;
    }

    match /fuarlar/{docId} {
      allow read, write: if request.auth != null;
    }

    match /todos/{docId} {
      allow read, write: if request.auth != null;

      match /notlar/{notId} {
        allow read, write: if request.auth != null;
      }
    }

    match /haber_sorgulari/{docId} {
      allow read, write: if request.auth != null;
    }

    match /ayarlar/{docId} {
      allow read, write: if request.auth != null;
    }

    match /manuel_ciro/{docId} {
      allow read, write: if request.auth != null;
    }

    match /kartvizitler/{docId} {
      allow read, write: if request.auth != null;
    }

    // Her kullanıcı sadece kendi PIN kaydına erişebilir — belge ID'si
    // kullanıcının kendi UID'si ile eşleşmeli.
    match /kullanici_pin/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Başka bir koleksiyona (örn. ihaleler) izin verilmedi —
    // ileride modül eklerken buraya yeni match blokları eklenecek.
  }
}
