[debug] [2026-08-30T06:56:41.062Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/strateji-rehberi/rulesets {"name":"projects/strateji-rehberi/rulesets/1640e24d-1c59-4975-9550-cc8cbaa428d0","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Sadece giriş yapmış kullanıcılar okuyabilir/yazabilir.\n    // İleride kullanıcı bazlı yetkilendirme eklemek isterseniz\n    // (örn. sadece belirli e-postalar), bu kuralı genişletebiliriz.\n    match /distributors/{docId} {\n      allow read, write: if request.auth != null;\n    }\n\n    match /fuarlar/{docId} {\n      allow read, write: if request.auth != null;\n    }\n\n    match /todos/{docId} {\n      allow read, write: if request.auth != null;\n\n      match /notlar/{notId} {\n        allow read, write: if request.auth != null;\n      }\n    }\n\n    match /haber_sorgulari/{docId} {\n      allow read, write: if request.auth != null;\n    }\n\n    match /takip_edilen_ulkeler/{docId} {\n      allow read, write: if request.auth != null;\n    }\n\n    match /ayarlar/{docId} {\n      allow read, write: if request.auth != null;\n    }\n\n    match /manuel_ciro/{docId} {\n      allow read, write: if request.auth != null;\n    }\n\n    match /kartvizitler/{docId} {\n      allow read, write: if request.auth != null;\n    }\n\n    match /mesaj_sablonlari/{docId} {\n      allow read, write: if request.auth != null;\n    }\n\n    // Değişiklik günlüğü — herkes (giriş yapmış kullanıcı) yazabilir, ama\n    // sadece yönetim hesabı okuyabilir. Bu, frontend'deki görünürlük\n    // kontrolünü sunucu tarafında da zorunlu kılar.\n    match /degisiklik_loglari/{docId} {\n      allow create: if request.auth != null;\n      allow read: if request.auth != null && request.auth.token.email == \"yonetim@pimetri.com\";\n    }\n\n    // Kullanıcı modül yetkileri — herkes kendi kaydını okuyabilir/oluşturabilir\n    // (ilk giriş kaydı için), ama sadece yönetim hesabı yetkileri düzenleyebilir\n    // ve tüm kullanıcı listesini okuyabilir.\n    match /kullanici_yetkileri/{docId} {\n      allow read: if request.auth != null;\n      allow create: if request.auth != null;\n      allow update: if request.auth != null && request.auth.token.email == \"yonetim@pimetri.com\";\n    }\n\n    // Başka bir koleksiyona (örn. ihaleler) izin verilmedi —\n    // ileride modül eklerken buraya yeni match blokları eklenecek.\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-30T06:56:40.216719Z","metadata":{"services":["cloud.firestore"]}}
